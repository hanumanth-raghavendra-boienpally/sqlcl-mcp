# Settings of the SQLcl MCP. This file is only a list: copy it to .env for local use (never commit .env).
# In the company workflow, "variable" entries go to GitHub Variables and "secret" entries to GitHub Secrets,
# and both are referenced in the deployment yaml. Do not put real values in this example file.

# --- required ---------------------------------------------------------------
ORACLE_USER=<oracle-login>                       # variable
ORACLE_PASSWORD=<oracle-password>                # SECRET (must not contain a double quote or a line break)
ORACLE_HOST=<bridge-host>                        # variable (the TCP bridge to the Oracle listener)
ORACLE_PORT=<bridge-port>                        # variable
ORACLE_SID=<sid>                                 # variable
SQLCL_MCP_TOKEN=<random-string-24-chars-or-more> # SECRET (callers send: Authorization: Bearer <token>)

# --- optional (defaults shown; already set in the Dockerfile) ----------------
# ORACLE_CONNECTION_NAME=vis_oracle              # variable
# SQLCL_MCP_HOST=0.0.0.0
# SQLCL_MCP_PORT=8770
# SQLCL_COMMAND=/opt/sqlcl/bin/sql
